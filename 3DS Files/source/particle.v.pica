; Vertex shader for the Acid particles (afx.c, TASKS.md #174).
;
; The particles are expanded into world-space quads on the CPU, the way
; retail's RenderEffects (SPEED2.EXE 0x48bdf0) hands finished corners to its
; sprite and quad batchers, so all that is left here is the transform and the
; colour. 24-byte vertices:
;
;   v0  position, float3, world space
;   v1  colour, 4 x u8 RGBA straight from the emitter's colour curve. The PICA
;       does not normalise byte attributes, so they arrive as 0..255 and are
;       scaled here.
;   v2  texcoord, float2, already flipped for the PICA's V axis
;
; CPU side precomputes:
;   mvp  - projection * view, one combined 4x4

.fvec mvp[4]

.constf myconst(0.0, 1.0, 0.00392156862745098, 0.5)
.alias  ones   myconst.yyyy
.alias  inv255 myconst.zzzz

.out outpos position
.out outtc0 texcoord0
.out outclr color

.alias inpos v0
.alias inclr v1
.alias intex v2

.proc main_particle
	mov r0.xyz, inpos
	mov r0.w,   ones

	dp4 r1.x, mvp[0], r0
	dp4 r1.y, mvp[1], r0
	dp4 r1.z, mvp[2], r0
	dp4 r1.w, mvp[3], r0
	mov outpos, r1

	mul outclr, inv255, inclr
	mov outtc0, intex

	end
.end

; #352: one of the shared worldsh blob's programs (shaders.h); its
; main has the file's name so the blob can hold them all.
.entry main_particle
