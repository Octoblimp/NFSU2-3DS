; scene.v.pica with the player's projected headlight (TASKS.md #296), for the
; world batches inside the headlight's frustum -- SPEED2.EXE's
; worldheadlight.efx vertex shader on top of the world's own:
;
;   oT1 = pos * HeadlightWVP              the HEADLIGHTS texture, projective
;   oT2 = (w * 0.005 + 0.5, ...)          the clip texture, along the beam
;   oT0 = uv + TextureOffset              the diffuse
;
; The world's own lighting is scene.v.pica's, unchanged, so a batch drawn here
; with the beam's texel at zero is the same pixel scene.v.pica gives it.
;
; CPU side (carlights.c builds `hl`, model3d.c uploads it):
;   mvp, shade, uvoff  - scene.v.pica's, declared first in the same order so
;                        they sit in the same registers and survive a switch
;                        between the two programs
;   hl[0]  - s * w row: the projector's x + 0.5 w
;   hl[1]  - t * w row: 0.5 w - its y (the PICA's V runs up the texture)
;   hl[2]  - the clip row: 0.005 * its w + 0.5
;   hl[3]  - the w row: depth along the projector
;
; Texture unit 0 is in projection mode (carlights.c loads HEADLIGHTS as
; GPU_TEX_PROJECTION), so it divides texcoord0 by texcoord0w itself. Unit 1
; is the batch's diffuse and unit 2 the clip, a 2D lookup at (clip, 0.5).
;
; texcoord0w rides in texcoord0's spare third component, as devkitPro's
; cubemap example has it. Every output register is written whole, each
; component exactly once: the PICA freezes on a component of an output it
; was told about that is left unwritten or written twice (3dbrew's
; GPU/Pitfalls). Azahar does not, so this shader drew there and hung the
; 3DS's first world frame with outtc0.w and outtc2.zw never written (#327).

.fvec mvp[4]
.fvec shade
.fvec uvoff
; posoff - a whole-metre point near the camera, subtracted from the position
;            before the matrix (TASKS.md #376-#378, #382, #387), which has it
;            folded in on the CPU; zero for everything but the world's
;            sections. The PICA200's shader floats have a 16-bit mantissa, and
;            a section's vertices sit a kilometre out in world space: dp4 over
;            those cancels its big terms to about a centimetre of depth, and the
;            rounding moves with the camera, so surfaces a few centimetres
;            apart -- a decal on the ground, a door over its interior -- took
;            turns in front frame to frame on the 3DS (the emulator's floats
;            are 32-bit and never showed it). Whole metres are exact in those
;            floats, so the subtraction is exact and the dp4 works on small
;            numbers.
.fvec posoff
.fvec hl[4]

.constf myconst(0.0, 1.0, -1.0, 0.5)
.constf tonec(0.000001, 0.0, 0.0, 0.0)
.alias  zeros myconst.xxxx
.alias  ones  myconst.yyyy
.alias  half  myconst.wwww
.alias  tiny  tonec.xxxx

.out outpos position
.out outtc0 texcoord0.st
.out -      texcoord0w outtc0.p
.out outtc1 texcoord1
.out outtc2 texcoord2
.out outclr color

.alias inpos v0
.alias inclr v1
.alias intex v2

.proc main_scenehl
	; Position -> clip space.
	add r0.xyz, -posoff, inpos
	mov r0.w,   ones

	dp4 r1.x, mvp[0], r0
	dp4 r1.y, mvp[1], r0
	dp4 r1.z, mvp[2], r0
	dp4 r1.w, mvp[3], r0
	mov outpos, r1

	; The projector's rows against the same world position.
	dp4 r2.x, hl[0], r0
	dp4 r2.y, hl[1], r0
	dp4 r2.z, hl[2], r0
	dp4 r2.w, hl[3], r0
	; (s w, t w, w) and (clip, 0.5), each built whole in a temporary and
	; written in one go, the spare components 0 (see the top).
	mov r8.xy, r2.xy
	mov r8.z,  r2.w
	mov r8.w,  zeros
	mov outtc0, r8
	mov r7.x,  r2.z
	mov r7.y,  half
	mov r7.zw, zeros
	mov outtc2, r7

	; scene.v.pica's colour, op for op (see its comments for the why).
	mov r6, shade

	max r4.xyz, tiny, inclr
	lg2 r3.x, r4.xxxx
	lg2 r3.y, r4.yyyy
	lg2 r3.z, r4.zzzz
	mul r3.xyz, r3, r6.zzzz
	ex2 r5.x, r3.xxxx
	ex2 r5.y, r3.yyyy
	ex2 r5.z, r3.zzzz

	mad r5.xyz, r5, r6.yyyy, r6.xxxx
	min r5.xyz, ones, r5

	mov outclr.xyz, r5
	mov outclr.w,   ones
	add outtc1, uvoff, intex

	end
.end

; #352: one of the shared worldsh blob's programs (shaders.h); its
; main has the file's name so the blob can hold them all.
.entry main_scenehl
